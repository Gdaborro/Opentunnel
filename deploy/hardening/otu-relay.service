# Reference only: node credentials/config are owned by root and readable by
# this node's relay identity. No panel DB, admin credentials or SSH inventory.
[Unit]
Description=OpenTunnel relay using a pinned central authority
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=otu-relay
Group=otu-relay
UMask=0077
Environment=TMPDIR=/var/lib/opentunnel-relay
ExecStart=/usr/local/bin/otu-server -c /etc/opentunnel-relay/server.toml
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
ReadWritePaths=/var/lib/opentunnel-relay
InaccessiblePaths=-/var/lib/opentunnel-authority -/etc/opentunnel-authority
LimitNOFILE=16384
TasksMax=512

[Install]
WantedBy=multi-user.target
